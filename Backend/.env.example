# Copy to .env and fill in. Never commit .env.

PORT=8080
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Extra allowed frontend origins, comma-separated (localhost:5173 is always allowed)
CORS_ORIGIN=https://aams-frontend.onrender.com

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Face recognition service (Backend/face-service) ---
# Started automatically with the backend once `npm run face:setup` has run.
# FACE_SERVICE_AUTOSTART=false      # don't start it
# FACE_SERVICE_PORT=8001            # local port for the child process
# FACE_SERVICE_URL=https://...      # use a separately deployed service instead
# FACE_SERVICE_KEY=                 # shared secret if the service is exposed publicly
# FACE_SERVICE_PYTHON=              # custom Python interpreter
# FACE_DETECTION_THRESHOLD=0.79     # YOLO confidence to count a face
# FACE_RECOGNITION_THRESHOLD=0.6    # max cosine distance for a match
